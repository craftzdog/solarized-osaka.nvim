[delta]
  minus-style                   = syntax "#ffd2d1"
  minus-non-emph-style          = syntax "#ffd2d1"
  minus-emph-style              = syntax "#ff9a99"
  minus-empty-line-marker-style = syntax "#ffd2d1"
  line-numbers-minus-style      = "#db302d"
  plus-style                    = syntax "#b7fefa"
  plus-non-emph-style           = syntax "#b7fefa"
  plus-emph-style               = syntax "#d6fead"
  plus-empty-line-marker-style  = syntax "#b7fefa"
  line-numbers-plus-style       = "#849900"
  line-numbers-zero-style       = "#adb7b7"
